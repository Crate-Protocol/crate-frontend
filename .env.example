# Sampled Frontend — Environment Variables
# Copy this file to .env and fill in your values

# Soroban contract address (deployed on testnet)
VITE_CONTRACT_ID=CA7DGEWWS3VH5J2I4I7FFEB5UHK2MJSYWDKDQKXQM7GDNLI2IRATDTLG

# Pinata JWT for IPFS uploads (get from pinata.cloud)
VITE_PINATA_JWT=your_pinata_jwt_here

# Stellar network: TESTNET or PUBLIC
VITE_NETWORK=TESTNET

# Pinata gateway (optional, for reading files)
VITE_PINATA_GATEWAY=https://gateway.pinata.cloud

# ── Cross-Chain (Circle CCTP v2) ─────────────────────────────────
# Circle's attestation API (sandbox for testnet, api.circle.com for mainnet)
VITE_CCTP_API_URL=https://iris-api-sandbox.circle.com

# CCTP Token Messenger contract on the source EVM chain (Ethereum testnet default)
VITE_CCTP_TOKEN_MESSENGER=0x9f3B8679c73C2Fef8b59B4f3b938142a750bD122

# CCTP Message Transmitter on Stellar testnet
VITE_CCTP_STELLAR_DEPOSIT_CONTRACT=

# Supported source chain IDs (comma-separated): 1=Eth, 8453=Base, 43114=Avalanche, 42161=Arbitrum, 137=Polygon, 59144=Linea
VITE_CCTP_SUPPORTED_CHAINS=11155111,84532,43113,421614,80002,59141

# USDC contract address on Stellar (SAC)
VITE_USDC_STELLAR_CONTRACT=
